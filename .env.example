# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# --- Public (safe to expose to the browser) ---------------------------------
# Canonical site URL, no trailing slash. Used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Public business email shown in the footer and legal pages. Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Database (REQUIRED for the waitlist) -----------------------------------
# Supabase → Project Settings → API (Data API URL, and the service_role / secret key).
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local preview without a database: set to "memory" (data is lost on restart;
# ignored on Vercel). Leave blank in real environments.
WAITLIST_STORE=

# --- Email via Resend (optional, recommended) -------------------------------
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Dash of Digital <hello@yourdomain.com>"
EMAIL_FROM=
# Private inbox that receives a notification for every submission.
FOUNDER_NOTIFICATION_EMAIL=
# Set to "false" to stop sending the visitor confirmation email.
SEND_CONFIRMATION_EMAIL=true

# --- Cloudflare Turnstile bot protection (optional) -------------------------
# Set BOTH to enable; leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
