# Dash of Digital — Hostinger (LiteSpeed/Apache) configuration.
# Generated by scripts/build-hostinger.sh for __SITE_URL__

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
__HTTPS_RULES__
  # One canonical host (redirects www <-> apex as configured)
  RewriteCond %{HTTP_HOST} !^__HOST_REGEX__$ [NC]
  RewriteRule ^ __SCHEME__://__HOST__%{REQUEST_URI} [L,R=301]

  # Waitlist API (the form posts to /api/waitlist)
  RewriteRule ^api/waitlist/?$ api/waitlist.php [L]

  # Never serve internal files
  RewriteRule ^api/(_config\.php|schema\.sql|\.htaccess)$ - [F,L]

  # Clean URLs: /privacy -> privacy.html (takes priority over the privacy/ data folder)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+?)/?$ $1.html [L]
</IfModule>

# Generated social preview image has no file extension
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
__HSTS__
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|ico|xml)$|^opengraph-image$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
